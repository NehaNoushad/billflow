# MongoDB connection string (local Docker or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/billflow

# Random string, at least 32 characters (generate: openssl rand -base64 48)
AUTH_SECRET=replace-me-with-a-long-random-string

# Public URL of the app (used in password reset emails)
APP_URL=http://localhost:3000

# Protects /api/cron/billing (Vercel Cron sends it as a Bearer token)
CRON_SECRET=replace-me

# Allow admins to reset the database to demo data from Settings
DEMO_MODE=true

# --- Optional: AI Revenue Guard (falls back to rule-based summaries if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional: SMTP for password reset and invoice emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BILLFLOW <billing@example.com>"
